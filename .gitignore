# secrets — never commit
.env

# personal data (changes constantly; back up separately if you care)
state.json
metrics.jsonl

# pre-migration snapshots of the above — irreplaceable, never committed
backups/

# the SQLite database and its WAL sidecars — personal data, same as state.json
*.db
*.db-wal
*.db-shm

# server log — rotated in place, never useful in a diff
dashboard.log*

.venv/
__pycache__/
.pytest_cache/
.ruff_cache/

# overnight batches from the scheduled task — regenerated nightly, never a diff
batches/

# rendered issue dossiers — personal notes, and regenerated from `debate_fact`
# on every write, so a committed copy would churn without ever being the record
dossiers/

# ND proxy
proxy.txt

# brokerage positions export — the actual portfolio, read by the locked panel.
# Never committed. The glob covers the dated filenames a download produces
# (Portfolio_Positions_Aug-14-2026.csv) as well as the file the config names,
# so a fresh export dropped in the directory is ignored before it is staged.
positions.csv
Portfolio_Positions*.csv


# textbooks — copies of PDFs read by the overnight generator. Large, and not
# ours to redistribute; the config names the path, git never carries the file.
textbooks/

# the recall boxes' scratch buffers — see [paths].scratch
scratch/
